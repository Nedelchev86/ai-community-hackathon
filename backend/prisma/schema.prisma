generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int                @id @default(autoincrement())
  email            String             @unique
  password         String
  name             String?
  avatarUrl        String?
  phone            String?
  city             String?
  bio              String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  donations        Donation[]
  exchangesAsReq   Exchange[]         @relation("RequesterExchanges")
  reviewsWritten   Review[]           @relation("ReviewsWritten")
  reviewsReceived  Review[]           @relation("ReviewsReceived")
  messages         Message[]
  eventsOrganized  Event[]
  eventsParticipating EventParticipant[]
}

model Event {
  id              Int                @id @default(autoincrement())
  title           String
  description     String
  category        String
  imageUrl        String?
  date            DateTime
  location        String
  lat             Float?
  lng             Float?
  maxParticipants Int
  organizerId     Int
  organizer       User               @relation(fields: [organizerId], references: [id])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  participants    EventParticipant[]
}

model EventParticipant {
  id        Int      @id @default(autoincrement())
  eventId   Int
  userId    Int
  event     Event    @relation(fields: [eventId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}

model Donation {
  id          Int        @id @default(autoincrement())
  type        String     @default("donation")
  title       String
  description String
  category    String
  imageUrl    String?
  city        String?
  lat         Float?
  lng         Float?
  status      String     @default("available")
  userId      Int
  user        User       @relation(fields: [userId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  exchanges   Exchange[]
}

model Exchange {
  id                 Int       @id @default(autoincrement())
  donationId         Int
  donation           Donation  @relation(fields: [donationId], references: [id])
  requesterId        Int
  requester          User      @relation("RequesterExchanges", fields: [requesterId], references: [id])
  status             String    @default("pending") // pending, accepted, completed, rejected
  requesterCompleted Boolean   @default(false)
  ownerCompleted     Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  reviews            Review[]
  messages           Message[]
}

model Message {
  id         Int      @id @default(autoincrement())
  content    String
  createdAt  DateTime @default(now())
  isRead     Boolean  @default(false)
  senderId   Int
  sender     User     @relation(fields: [senderId], references: [id])
  exchangeId Int
  exchange   Exchange @relation(fields: [exchangeId], references: [id])
}

model Review {
  id          Int      @id @default(autoincrement())
  exchangeId  Int
  exchange    Exchange @relation(fields: [exchangeId], references: [id])
  reviewerId  Int
  reviewer    User     @relation("ReviewsWritten", fields: [reviewerId], references: [id])
  revieweeId  Int
  reviewee    User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  rating      Int
  comment     String?
  imageUrl    String?
  createdAt   DateTime @default(now())
}
